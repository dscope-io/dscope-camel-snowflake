# Local environment overrides for Snowflake testing
# This file is ignored by git - add your real credentials here

# Your actual Snowflake connection details
SNOWFLAKE_ACCOUNT=mycompany.us-east-1
SNOWFLAKE_USERNAME=my_username
SNOWFLAKE_PASSWORD=my_secure_password
SNOWFLAKE_DATABASE=TEST_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=MY_ROLE

# Optional: Private Key Authentication
# SNOWFLAKE_PRIVATE_KEY=MIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...

# Test-specific settings
SNOWFLAKE_TEST_TABLE=camel_test_table
SNOWFLAKE_TEST_QUERY=SELECT * FROM camel_test_table LIMIT 5