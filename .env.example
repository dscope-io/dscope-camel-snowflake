# Snowflake Connection Configuration Example
# Copy this file to .env and fill in your actual values

# Snowflake Account Information
SNOWFLAKE_ACCOUNT=your-account-name
SNOWFLAKE_USERNAME=your-username

# Authentication (use either password OR private key)
SNOWFLAKE_PASSWORD=your-password
# SNOWFLAKE_PRIVATE_KEY=your-base64-encoded-private-key-without-headers

# Database Configuration
SNOWFLAKE_DATABASE=your-database
SNOWFLAKE_SCHEMA=your-schema
SNOWFLAKE_WAREHOUSE=your-warehouse
SNOWFLAKE_ROLE=your-role

# Example Values for Testing
# SNOWFLAKE_QUERY=SELECT 1 as test_column
# SNOWFLAKE_TABLE=test_table

# Sample Example Configuration
# For the provided sample (YOUR_DB.PUBLIC.SOME_TABLE), you might have:
# SNOWFLAKE_DATABASE=YOUR_DB
# SNOWFLAKE_SCHEMA=PUBLIC
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=SAMPLE_ROLE

# Security Notes:
# - Never commit actual credentials to version control
# - Use private key authentication for enhanced security
# - Private keys should be in PKCS#8 format without BEGIN/END headers
# - Store private keys securely and restrict file permissions